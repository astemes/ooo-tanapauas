{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mock-box",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "mock"
      ],
      "env": {
        "MOCK_CLOCK": "1",
        "MOCK_SPEED": "60"
      },
      "port": 8787
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    }
  ]
}